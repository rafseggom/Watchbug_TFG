# Watchbug — environment template (SEC-04: zero secrets in code)
# ---------------------------------------------------------------------------
# Copy to `.env` (`cp .env.example .env`) and edit. `.env` is git-ignored;
# THIS file is committed and documents every server setting (DEP-02).
#
# PRECEDENCE CONTRACT (deterministic, Node `--env-file` semantics):
#   1. A real process environment variable always wins over a `.env` value.
#   2. Inside the file, the LAST occurrence of a duplicate key wins.
#   3. An empty value is a real empty value: required settings abort boot
#      loudly naming the variable and this file; optional settings fall back
#      to the default documented next to them (never to 0 or unbounded).
# ---------------------------------------------------------------------------

# --- Database (compose service `db`) -------------------------------------
WATCHBUG_DB_USER=watchbug
# Development-only credential shipped in the template. Change it before the
# instance is reachable by anyone else.
WATCHBUG_DB_PASSWORD=watchbug
WATCHBUG_DB_NAME=watchbug
# Host-side connection string (drizzle-kit generate/migrate, `npm run dev`).
# `db` publishes 127.0.0.1:5433 (5432 may already be taken by a host Postgres),
# so this works from your shell. Inside the
# compose network the `api` service swaps the host segment for the `db`
# service name (see docker-compose.yml) using the three WATCHBUG_DB_* values
# above — keep this URL's credentials in sync with them.
DATABASE_URL=postgres://watchbug:watchbug@127.0.0.1:5433/watchbug

# --- Project key (REQUIRED — P1-D-02 / P1-D-03) --------------------------
# Format: `wkbt_` + exactly 32 base62 characters [0-9A-Za-z] (~190 bits).
# Generate a real one with:   npm run key:gen
#
# Leaving this EMPTY aborts boot, naming WATCHBUG_PROJECT_KEY and this file.
# The commented sample below is the documented placeholder: it is also
# rejected at boot, and it is NOT a usable key.
WATCHBUG_PROJECT_KEY=
# WATCHBUG_PROJECT_KEY=wkbt_00000000000000000000000000000000

# --- CORS allowlist (ING-08, A-11) ----------------------------------------
# Comma-separated browser origins accepted for POST /api/incidents.
# Enforcement happens ONLY when an `Origin` header is present (Pitfall 9):
# a non-allowlisted browser origin gets 403 and nothing is stored, while
# header-less clients (curl, server-to-server — P1-D-07's onboarding flow)
# are always accepted. Empty value = NO browser origin is trusted (it does
# not mean "all origins").
# The loopback values below are what the compose stack itself uses
# (panel origin on 127.0.0.1 / localhost:8080) — replace them with your
# host app's origin(s) when you integrate the SDK.
WATCHBUG_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Retention TTLs (M-1/A-02, in days) ----------------------------------
# Identity fields (user.id/name/email) purge after this many days; the whole
# incident (screenshot + metadata) after this. Empty = documented default.
WATCHBUG_TTL_IDENTITY_DAYS=30
WATCHBUG_TTL_ARTIFACT_DAYS=90

# --- Retention purge job (S-2 / RET-01, RET-02) ---------------------------
# The api process sweeps once at boot and then every N minutes. Each sweep
# nulls user.id/name/email where the identity TTL is due and deletes the
# incident plus its attachment blob where the artifact TTL is due. Empty =
# default 60. The job runs INSIDE the api container: INV-03 permits exactly
# three services, so there is no cron sidecar.
WATCHBUG_PURGE_INTERVAL_MINUTES=60

# --- Rate limits (ING-05; in-memory — INV-03 forbids a Redis container) ---
# Three composed layers, each enforced as its own limiter on POST /api/incidents;
# a request over ANY limit gets 429 + an integer Retry-After (seconds ≥ 1).
# Empty = the documented default from packages/contracts/src/constants.ts.
#
# These values are what `npm run verify` exercises, so the documented
# quickstart (`cp .env.example .env && npm run key:gen && docker compose up -d
# && npm run verify`, SKELETON.md) runs VERBATIM (WR-04). Two hard constraints
# from the suite's row design explain every one of them:
#   - per-IP < per-key: each ING-05 row isolates ONE dimension, so the row
#     that fires exactly max+1 per-IP requests must never trip the per-key
#     limiter first (the suite fails loud if `.env` breaks this ordering);
#   - per-day <= ~2 x per-key: the daily row must fire ALL `per-day` requests
#     through the per-key minute buckets inside its 600 s budget (one 65 s
#     window reset per batch) — at 10/min a 2000/day quota would need ~200
#     minutes and time out.
# For production hardening, set these three keys to the constants (or leave
# them EMPTY to fall back to them): 10 / 30 / 2000 from
# packages/contracts/src/constants.ts. The boundary rows only constrain
# `npm run verify`, never a production deployment.
WATCHBUG_RATE_LIMIT_PER_KEY_PER_MIN=1200
WATCHBUG_RATE_LIMIT_PER_IP_PER_MIN=600
WATCHBUG_RATE_LIMIT_PER_PROJECT_PER_DAY=2000
# Caveats (documented deliberately — Pitfall 5):
#  - The store is IN-MEMORY per process (single-node self-hosting under
#    INV-03): counters reset on restart, so the daily quota is BEST-EFFORT
#    across restarts.
#  - The per-IP bucket is keyed on the resolved client IP. Behind a NAT
#    (university, office, carrier-grade NAT) every user sharing the egress
#    IP shares ONE bucket — if legitimate users get 429s, raise
#    WATCHBUG_RATE_LIMIT_PER_IP_PER_MIN for that deployment.
#  - The per-IP key only reads X-Forwarded-For because WATCHBUG_TRUST_PROXY
#    is set (see HTTP section below).

# --- Storage (R-04) -------------------------------------------------------
# Path INSIDE the api container. docker-compose mounts the attachments volume
# here; it holds `blobs/<projectId>/<xx>/<uuid>.<ext>` (server-generated keys)
# and `tmp/` (in-flight writes, renamed into place atomically).
# The api runs as the unprivileged `node` user (WR-06): keep this at /data so
# a fresh volume initialises with node-writable ownership. If you change it,
# pre-chown the mounted directory for uid 1000 once.
WATCHBUG_DATA_DIR=/data

# --- HTTP -----------------------------------------------------------------
PORT=3000
# Listen address. Local dev defaults to 127.0.0.1 (loopback only); the compose
# api service sets 0.0.0.0 because nginx reaches it as `api:3000` on the
# container network — the published port is still bound to loopback on the host.
WATCHBUG_HOST=127.0.0.1
# Trust `X-Forwarded-For` / `X-Forwarded-Proto` — but ONLY from the hops below.
# CR-02 (Pitfall 5): a blanket `true` trusts every hop, so `req.ip` (the
# per-IP rate-limit key) becomes the attacker-controlled LEFTMOST
# X-Forwarded-For entry and the limiter is spoofable. The secure value is a
# TRUST LIST of exactly the proxies YOU control: Fastify then resolves `req.ip`
# from the first UNTRUSTED entry walking outwards from the socket, and the
# panel's nginx additionally OVERWRITES the header at the edge, so a forged
# entry never reaches the API at all.
#   127.0.0.1/8,::1/128 — this machine: local tooling and the verify suite
#                         (which speaks straight to 127.0.0.1:3000)
#   172.16.0.0/12       — the compose network hop (the nginx edge)
# Without 172.16.0.0/12 the per-IP limiter would see nginx's container IP for
# all proxied traffic and bucket every visitor together (shared-bucket 429s).
# `true` (trust everything — spoofable, do not use) and `false` (ignore
# X-Forwarded-For entirely) remain valid boolean values.
WATCHBUG_TRUST_PROXY=127.0.0.1/8,::1/128,172.16.0.0/12
