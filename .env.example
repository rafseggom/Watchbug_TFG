# Watchbug Backend Environment Variables
# Copy to backend/.env and fill values

# Database - PostgreSQL async driver (asyncpg required, not psycopg2)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://watchbug:watchbug@localhost:5432/watchbug

# JWT - must be at least 32 characters (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seeding - used on startup to create/update users table row (idempotent)
ADMIN_EMAIL=admin@watchbug.local
ADMIN_PASSWORD=Admin123!

# CORS - comma-separated exact origin allowlist for admin/panel routes
# Ingest POST /api/incidents is open to any Origin (requires PROJECT_KEY)
CORS_ORIGINS=http://localhost:5173

# Docs - set true to enable /docs and /openapi.json (dev only)
DOCS_ENABLED=false

# Payload size guard - max bytes for POST /api/incidents (413 if exceeded)
MAX_PAYLOAD_BYTES=102400

# Default project API key for seeding (public write-only key for SDK)
DEFAULT_PROJECT_API_KEY=wb_test_project_key_123

# Environment - development disables Secure cookie flag for localhost http; production enables Secure
ENV=development
