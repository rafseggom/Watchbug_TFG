# Watchbug Backend Environment Variables
# Copy to backend/.env and fill values for host development.
# For Docker Compose: copy to .env at repo root and edit values.
# Compose provides secure production defaults; env_file .env overrides them.

# --- Database ---------------------------------------------------------------
# PostgreSQL async driver (asyncpg required, not psycopg2)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# HOST DEV: use @localhost:5432 (or 127.0.0.1:5432 on Windows to avoid 10s IPv6 fallback)
# DOCKER:   compose sets @db:5432 via bridge DNS (service name 'db'); leave localhost here for host tooling
DATABASE_URL=postgresql+asyncpg://watchbug:watchbug@localhost:5432/watchbug

# --- JWT -------------------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRITICAL: Replace the placeholder below before production use.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin seeding ---------------------------------------------------------
# Used on startup to create/update users table row (idempotent).
# Change ADMIN_PASSWORD before exposing port 8000 publicly.
ADMIN_EMAIL=admin@watchbug.local
ADMIN_PASSWORD=Admin123!

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origin allowlist for admin/panel routes.
# NEVER use * with credentials — Starlette raises ValueError.
# Ingest POST /api/incidents has open CORS via IngestCorsMiddleware (separate).
CORS_ORIGINS=http://localhost:5173

# --- Docs ------------------------------------------------------------------
# Set true to enable /docs and /openapi.json (dev only, disable in production)
DOCS_ENABLED=false

# --- Payload ---------------------------------------------------------------
# Max bytes for POST /api/incidents (413 if exceeded)
MAX_PAYLOAD_BYTES=102400

# --- Project ---------------------------------------------------------------
# Default project API key for seeding (public write-only key for SDK)
DEFAULT_PROJECT_API_KEY=wb_test_project_key_123

# --- Environment -----------------------------------------------------------
# development = Secure cookie flag disabled (localhost http)
# production  = Secure cookie flag enabled
# NOTE: docker-compose.yml defaults to production via ${ENV:-production}.
#       The env_file .env overrides this default. Set ENV=development here
#       only for local host development.
ENV=development

# =============================================================================
# Docker Compose overrides (uncomment to override compose defaults)
# =============================================================================
# These variables are read by docker-compose.yml but are NOT part of the
# backend Settings class. They only apply to the PostgreSQL container.

# POSTGRES_DB=watchbug          # database name (must match DATABASE_URL dbname)
# POSTGRES_USER=watchbug        # postgres superuser (must match DATABASE_URL user)
# POSTGRES_PASSWORD=watchbug    # postgres password (must match DATABASE_URL password)
#
# IMPORTANT: POSTGRES_* env vars only take effect on FIRST volume init
# (when /var/lib/postgresql/data is empty). After the first boot, changing
# these values has NO effect. To rotate the PostgreSQL password after first
# boot:
#   docker exec -it db psql -U watchbug -c "ALTER USER watchbug PASSWORD 'newpassword';"
# Or wipe the volume and re-seed:
#   docker compose down -v && docker compose up -d --build
# WARNING: down -v DESTROYS all incidents and users data.

# PORT=8000                    # optional: host port remap (default 8000)
