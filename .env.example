# Watchbug — environment template (SEC-04: zero secrets in code)
# ---------------------------------------------------------------------------
# Copy to `.env` (`cp .env.example .env`) and edit. `.env` is git-ignored;
# THIS file is committed and documents every server setting (DEP-02).
#
# PRECEDENCE CONTRACT (deterministic, Node `--env-file` semantics):
#   1. A real process environment variable always wins over a `.env` value.
#   2. Inside the file, the LAST occurrence of a duplicate key wins.
#   3. An empty value is a real empty value: required settings abort boot
#      loudly naming the variable and this file; optional settings fall back
#      to the default documented next to them (never to 0 or unbounded).
# ---------------------------------------------------------------------------

# --- Database (compose service `db`) -------------------------------------
WATCHBUG_DB_USER=watchbug
# Development-only credential shipped in the template. Change it before the
# instance is reachable by anyone else.
WATCHBUG_DB_PASSWORD=watchbug
WATCHBUG_DB_NAME=watchbug
# Host-side connection string (drizzle-kit generate/migrate, `npm run dev`).
# `db` publishes 127.0.0.1:5432, so this works from your shell. Inside the
# compose network the `api` service swaps the host segment for the `db`
# service name (see docker-compose.yml) using the three WATCHBUG_DB_* values
# above — keep this URL's credentials in sync with them.
DATABASE_URL=postgres://watchbug:watchbug@127.0.0.1:5432/watchbug

# --- Project key (REQUIRED — P1-D-02 / P1-D-03) --------------------------
# Format: `wkbt_` + exactly 32 base62 characters [0-9A-Za-z] (~190 bits).
# Generate a real one with:   npm run key:gen
#
# Leaving this EMPTY aborts boot, naming WATCHBUG_PROJECT_KEY and this file.
# The commented sample below is the documented placeholder: it is also
# rejected at boot, and it is NOT a usable key.
WATCHBUG_PROJECT_KEY=
# WATCHBUG_PROJECT_KEY=wkbt_00000000000000000000000000000000

# --- CORS allowlist (ING-08) ---------------------------------------------
# Comma-separated browser origins, e.g. https://app.example.com
# Empty = no browser origin is allowed to POST; header-less clients (curl,
# server-to-server) are always accepted.
WATCHBUG_CORS_ORIGINS=

# --- Retention TTLs (M-1/A-02, in days) ----------------------------------
# Identity fields (user.id/name/email) purge after this many days; the whole
# incident (screenshot + metadata) after this. Empty = documented default.
WATCHBUG_TTL_IDENTITY_DAYS=30
WATCHBUG_TTL_ARTIFACT_DAYS=90

# --- Rate limits (ING-05; in-memory — INV-03 forbids a Redis container) ---
WATCHBUG_RATE_LIMIT_PER_KEY_PER_MIN=10
WATCHBUG_RATE_LIMIT_PER_IP_PER_MIN=30
WATCHBUG_RATE_LIMIT_PER_PROJECT_PER_DAY=2000

# --- Storage (R-04) -------------------------------------------------------
# Path INSIDE the api container. docker-compose mounts the attachments volume
# here; it holds `blobs/<projectId>/<xx>/<uuid>.<ext>` (server-generated keys)
# and `tmp/` (in-flight writes, renamed into place atomically).
WATCHBUG_DATA_DIR=/data

# --- HTTP -----------------------------------------------------------------
PORT=3000
# Trust `X-Forwarded-For` / `X-Forwarded-Proto`. Keep `false` unless a proxy
# YOU control sets them: trusting them blindly lets any client spoof its IP and
# defeat the per-IP rate limit and any audit trail (Pitfall 5).
WATCHBUG_TRUST_PROXY=false
