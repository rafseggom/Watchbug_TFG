{
  "name": "@watchbug/api",
  "version": "0.1.0",
  "private": true,
  "description": "Watchbug ingestion + admin API (Fastify 5).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --target=es2020 --platform=node --format=esm --packages=external --metafile=dist/meta.json --outfile=dist/index.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node --env-file=.env dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@watchbug/contracts": "*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "sanitize-html": "2.18.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
